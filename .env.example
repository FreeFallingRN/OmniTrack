# OmniTrack Environment Configuration
# Copy this file to .env and fill in your Supabase project values

# Supabase REST & Auth API Credentials
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Direct PostgreSQL Database URL (Used for Migrations & CI/CD)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres (Session or Transaction pooler)
# or direct: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Sync Worker (Google Apps Script / Clasp)
# Script ID found in Google Apps Script -> Project Settings
GAS_SCRIPT_ID=
# Target folder in Google Drive (Default: Apps/Books/.Moon+/Cache/)
MOON_READER_DRIVE_FOLDER=Apps/Books/.Moon+/Cache/
