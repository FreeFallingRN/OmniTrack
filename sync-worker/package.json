{
  "name": "@omnitrack/sync-worker",
  "version": "1.0.0",
  "description": "Google Apps Script headless worker syncing Moon+ Reader position files from Google Drive to Supabase",
  "main": "dist/Code.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --outfile=dist/Code.js --platform=neutral --target=es2020 && copyfiles appsscript.json dist/",
    "build:tsc": "tsc",
    "push": "clasp push",
    "deploy": "npm run build && clasp push --force"
  },
  "dependencies": {},
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.89",
    "@types/node": "^22.13.4",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}

